# --- Kierre's Vintage Vault : backend environment ---
# Copy this file to ".env" and adjust the values.

# Port the Express server listens on.
PORT=5000

# Secret used to sign JWT access tokens. Use any long random string.
JWT_SECRET=change_this_to_a_long_random_string

# How long a login token stays valid.
JWT_EXPIRES_IN=7d

# Path of the SQLite database file (relative to the backend folder).
DATABASE_URL=./data/vintagevault.db

# How long an item stays reserved before it goes back to "Available".
RESERVATION_MINUTES=15

# Flat delivery fee in Philippine Peso. Pickup orders are always free.
DELIVERY_FEE=80
